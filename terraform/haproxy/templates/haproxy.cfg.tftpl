global
  log /dev/log local0
  log /dev/log local1 notice
  chroot /var/lib/haproxy
  stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
  stats timeout 30s
  user haproxy
  group haproxy
  daemon
  maxconn ${maxconn}

defaults
  log global
  mode tcp
  option tcplog
  timeout connect 5s
  timeout client 50s
  timeout server 50s

frontend http_in
  bind ${frontend_ip}:80
  mode tcp
  default_backend ingress_http

backend ingress_http
  mode tcp
  balance ${balance_algorithm}
  server ingress ${ingress_vip}:80 check

frontend https_in
  bind ${frontend_ip}:443
  mode tcp
  default_backend ingress_https

backend ingress_https
  mode tcp
  balance ${balance_algorithm}
  server ingress ${ingress_vip}:443 check
