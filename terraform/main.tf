resource "proxmox_virtual_environment_vm" "k8s" {
  for_each = var.virtual_machines

  # =========================================================
  # 기본 VM 정보
  # =========================================================
  name      = each.key
  vm_id     = each.value.id
  node_name = each.value.node

  # =========================================================
  # QEMU Guest Agent
  # =========================================================
  agent {
    enabled = true
  }

  # =========================================================
  # CPU / Memory
  # =========================================================
  cpu {
    cores = each.value.cpu
    type  = "host"
  }

  memory {
    dedicated = each.value.memory
  }

  # =========================================================
  # Template Clone
  # =========================================================
  clone {
    # Template VM 이 존재하는 노드
    node_name = "team14"

    # Template VM ID
    vm_id = var.template_vm_id

    # Full Clone 사용
    full = true
  }

  # =========================================================
  # Cloud-Init 설정
  # =========================================================
  initialization {

    # -------------------------------------------------------
    # net0 (vmbr0)
    # 관리망 / 1G / DHCP
    # -------------------------------------------------------
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }

    # -------------------------------------------------------
    # net1 (vmbr1)
    # Kubernetes 내부망 / 10G / Static IP
    # -------------------------------------------------------
    ip_config {
      ipv4 {
        address = "${each.value.ip}/24"
      }
    }

    # -------------------------------------------------------
    # VM 계정 설정
    # -------------------------------------------------------
    user_account {
      #  username = var.vm_user
      #  password = var.vm_password
      keys = [var.ssh_public_key]
    }

    # -------------------------------------------------------
    # Cloud-Init User Data
    # -------------------------------------------------------
    user_data_file_id = "local:snippets/init-${each.key}.yml"
  }

  # =========================================================
  # 운영체제 설정
  # =========================================================
  operating_system {
    type = "l26"
  }

  # =========================================================
  # 부팅 및 SCSI 설정
  # =========================================================
  scsi_hardware = "virtio-scsi-pci"

  boot_order = ["scsi0"]

  # =========================================================
  # 디스크 설정
  # =========================================================
  disk {
    datastore_id = "ceph-rbd"
    interface    = "scsi0"
    size         = 20

    # Ceph + Kubernetes면 권장
    discard  = "on"
    iothread = true
    ssd      = true
  }

  # =========================================================
  # 네트워크 인터페이스
  # =========================================================

  # ---------------------------------------------------------
  # net0 → vmbr0
  # 관리망 (1G)
  # ---------------------------------------------------------
  network_device {
    bridge  = "vmbr0"
    model   = "virtio"
    vlan_id = 40
  }

  # ---------------------------------------------------------
  # net1 → vmbr1
  # Kubernetes 내부망 (10G)
  # ---------------------------------------------------------
  network_device {
    bridge = "vmbr1"
    model  = "virtio"
  }

  # =========================================================
  # VGA
  # =========================================================
  vga {
    type = "std"
  }

  # =========================================================
  # Terraform Lifecycle
  # =========================================================
  lifecycle {
    ignore_changes = [
      network_device,
      disk
    ]
  }
}